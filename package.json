{
  "name": "kia-subtitle",
  "version": "4.0.2",
  "description": "Adds a subtitle field to WordPress' Post editor",
  "main": "Gruntfile.js",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/helgatheviking/kia-subtitle"
  },
  "bugs": {
    "url": "https://github.com/helgatheviking/kia-subtitle/issues"
  },
  "author": "helgatheviking",
  "devDependencies": {
    "@wordpress/dependency-extraction-webpack-plugin": "^6.45.0",
    "@wordpress/icons": "^13.0.0",
    "@wordpress/scripts": "^32.1.0",
    "classnames": "^2.5.1",
    "grunt": "^1.6.2",
    "grunt-contrib-clean": "~2.0.1",
    "grunt-contrib-compress": "^2.0.0",
    "grunt-contrib-copy": "~1.0.0",
    "grunt-contrib-jshint": "^3.2.0",
    "grunt-contrib-uglify": "~5.2.2",
    "grunt-text-replace": "^0.4.0",
    "grunt-wp-i18n": "~1.0.4",
    "grunt-wp-readme-to-markdown": "~2.1.0",
    "jshint-stylish": "^2.2.1",
    "load-grunt-tasks": "~5.1.0"
  },
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=\"assets/js/src\" --output-path=\"assets/js/dist\" --webpack-copy-php",
    "deploy": "npm run build && npm run makepot && grunt deploy",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "makepot": "composer run-script makepot",
    "release": "npm run build && npm run makepot && grunt build",
    "start": "wp-scripts start --webpack-src-dir=\"assets/js/src\" --output-path=\"assets/js/dist\" --webpack-copy-php"
  }
}
